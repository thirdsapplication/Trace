{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trace.dev/schema/discovery.schema.json",
  "title": "Trace discovery output (Discovery Engine -> Artifact C contract)",
  "type": "object",
  "required": ["bundles", "anti_bundles", "unclustered_or_noise_event_ids", "notes"],
  "additionalProperties": false,
  "properties": {
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "trigger", "steps", "frequency",
                     "evidence_event_ids", "why_automatable", "rationale", "confidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^B[0-9]+$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "trigger": { "type": "string" },
          "steps": { "type": "array", "items": { "type": "string" } },
          "frequency": { "type": "string" },
          "evidence_event_ids": { "type": "array", "items": { "type": "string" } },
          "why_automatable": { "type": "string" },
          "rationale": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "apps": { "type": "array", "items": { "type": "string" },
                    "description": "Optional (v2). The connectable apps the workflow runs in, as human names." },
          "grouping_rationale": { "type": "string",
                                  "description": "Optional (v2). One line: why these tasks belong to one agent." },
          "unknowns": {
            "type": "array",
            "description": "Optional (v2). What capture could not see; later stages ask rather than assume.",
            "items": {
              "type": "object",
              "required": ["what", "evidence"],
              "properties": {
                "what": { "type": "string" },
                "evidence": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "anti_bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "why_judgment",
                     "recommended_handling", "rationale", "evidence_event_ids", "confidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^A[0-9]+$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "why_judgment": { "type": "string" },
          "recommended_handling": { "type": "string" },
          "rationale": { "type": "string" },
          "evidence_event_ids": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "apps": { "type": "array", "items": { "type": "string" } },
          "trigger": { "type": "string" },
          "steps": { "type": "array", "items": { "type": "string" } },
          "reason": {
            "type": "object",
            "description": "Optional (v2). Why this is an anti-bundle: the unsupported app, or the step that needs judgment. reason.why is also written to why_judgment.",
            "required": ["type", "why"],
            "properties": {
              "type": { "type": "string", "enum": ["unsupported_app", "judgment"] },
              "app": { "type": ["string", "null"] },
              "step": { "type": ["integer", "null"] },
              "why": { "type": "string" }
            }
          }
        }
      }
    },
    "unclustered_or_noise_event_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" }
  }
}
