{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trace.dev/schema/agent_envelope.schema.json",
  "title": "Trace Stage 4 agent envelope (Managed Agents agent definition)",
  "type": "object",
  "required": ["name", "description", "model", "system", "tools"],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "model": { "type": "string" },
    "system": { "type": "string", "description": "framing + the spec content, verbatim" },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "mcp_server_name": { "type": "string" },
          "default_config": {
            "type": "object",
            "properties": {
              "permission_policy": {
                "type": "object",
                "required": ["type"],
                "properties": { "type": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "mcp_servers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url", "type"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    }
  }
}
