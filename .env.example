# Trace backend — environment variables (Phase 1).
#
# Copy to .env for a local run (`cp .env.example .env`), then fill in values.
# .env is git-ignored and never committed. In the cloud, Render supplies these
# same names as real environment variables (see render.yaml) — same code, two
# sources. This file is the exact checklist of names to paste into Render.
# NO REAL VALUES HERE.

# --- Required: model + connector platform secrets --------------------------

# Anthropic API key — used by every LLM call (reconstruct/discovery/interview/
# config) and the Managed Agents platform.
ANTHROPIC_API_KEY=

# Pipedream Connect — one account fronts all customers (OAuth + MCP + triggers).
PIPEDREAM_PROJECT_ID=
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_ENVIRONMENT=          # "production" or "development"

# App session secret — any long random string. On Render this is generated
# automatically (render.yaml); set it yourself only for a local run.
SESSION_SECRET=

# --- Database --------------------------------------------------------------

# Postgres connection string. On Render this is filled in automatically from the
# managed database (do NOT paste it there). Leave blank for a local run with no
# database — the backend boots fine without it and skips schema creation.
DATABASE_URL=

# --- Optional: server binding + local paths (sensible defaults) ------------

# HOST defaults to 127.0.0.1 locally; render.yaml sets 0.0.0.0 in the cloud.
# PORT defaults to 8765 locally; Render injects $PORT automatically.
# HOST=127.0.0.1
# PORT=8765

# Where pipeline session artifacts are written (default: captures/sessions).
# TRACE_SESSIONS_ROOT=captures/sessions

# Set to 1 to disable self-registration (run provisioned-only).
# TRACE_DISABLE_SIGNUP=
