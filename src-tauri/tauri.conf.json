{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trace",
  "version": "0.1.0",
  "identifier": "com.trace.desktop",
  "build": {
    "frontendDist": "../desktop/webroot"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Trace",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Capture your work; Trace builds the agents.",
    "externalBin": ["binaries/trace-node"],
    "icon": ["icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "shell": {
      "open": false
    }
  }
}
